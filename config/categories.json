        { "id": "services", "label": "Salons & services", "icon": "hairdresser", "rank": 5, "minzoom": 15,
          "match": [
            { "shop": ["hairdresser", "beauty", "laundry", "dry_cleaning", "massage", "tattoo", "photo", "copyshop", "travel_agency", "optician"] },
            { "amenity": "coworking_space" }
          ] },
        { "id": "shop", "label": "Other shops", "icon": "shop", "rank": 5, "minzoom": 15,
          "match": [{ "shop": "*" }] }
      ]
    },
    {
      "id": "civic",
      "label": "Civic & emergency",
      "colour": "#5B6B7F",
      "categories": [
        { "id": "police", "label": "Police", "icon": "police", "rank": 1, "minzoom": 13,
          "match": [{ "amenity": "police" }] },
        { "id": "fire_station", "label": "Fire stations", "icon": "fire-station", "rank": 1, "minzoom": 13,
