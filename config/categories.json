{
  "$schema": "./schema/categories.schema.json",
  "version": 1,
  "notes": "Rules are evaluated top to bottom; the first matching category wins. A rule matches when every key matches. Values: exact string, list of strings, \"*\" (any value except \"no\"), or \"!value\" (tag absent or different).",
  "groups": [
    {
      "id": "transport",
      "label": "Transport",
      "colour": "#0B84E6",
      "categories": [
        { "id": "metro_station", "label": "Metro stations", "icon": "rail-metro", "rank": 1, "minzoom": 11,
          "match": [
            { "railway": ["station", "halt"], "station": ["subway", "light_rail"] },
            { "railway": ["station", "halt"], "subway": "yes" },
            { "railway": ["station", "halt"], "light_rail": "yes" },
            { "public_transport": "station", "subway": "yes" }
          ] },
        { "id": "monorail_station", "label": "Monorail stations", "icon": "rail-light", "rank": 1, "minzoom": 12,
